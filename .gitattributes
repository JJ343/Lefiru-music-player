# Normalize line endings across platforms
* text=auto

# Source and text files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf

# Binary files
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
